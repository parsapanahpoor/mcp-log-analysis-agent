{
  "McpServer": {
    "Command": "dotnet",
    "Arguments": [
      "run",
      "--project",
      "src/Dotin.DotNetForum.LogAgent.McpServer",
      "--no-launch-profile"
    ]
  },
  "ServiceAliases": {
    "Aliases": {
      "payment": "PaymentService",
      "pay": "PaymentService",
      "payment service": "PaymentService",
      "payment gateway": "PaymentService",
      "order": "OrderService",
      "orders": "OrderService",
      "order service": "OrderService",
      "auth": "AuthService",
      "authentication": "AuthService",
      "auth service": "AuthService",
      "login": "AuthService",
      "inventory": "InventoryService",
      "stock": "InventoryService",
      "notification": "NotificationService",
      "email": "NotificationService"
    }
  },
  "Agent": {
    "DefaultMinutesAgo": 30,
    "RequestTimeoutSeconds": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "ModelContextProtocol": "Warning"
    }
  }
}
